{
  "topicId": "p4-pharmacogenomics",
  "cards": [
    {
      "id": "rf-p4-pharmacogenomics-0001",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Pharmacogenetics definition",
      "a": "Study of the genetic basis of variable drug response; often a few variants with large effects",
      "refs": [
        "GG14 ch7",
        "KDT8 ch5"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0002",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Pharmacogenomics definition",
      "a": "Study of many variants, in an individual or across a population, explaining genetic influence on drug response",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0003",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Pharmacogenomics vs pharmacogenetics breadth",
      "a": "Pharmacogenomics studies larger numbers of variants, in individuals or across populations",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0004",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "class",
      "q": "Genetic defects giving discontinuous drug response: first two in the KDT list",
      "a": "Atypical pseudocholinesterase; G6PD deficiency",
      "refs": [
        "KDT8 ch5"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0005",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Distribution of drug response for most drugs",
      "a": "Continuous, bell-shaped (Gaussian) variation",
      "refs": [
        "KDT8 ch5"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0006",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Source of discontinuous variation in drug response",
      "a": "Specific genetic defects, e.g. atypical pseudocholinesterase, G6PD deficiency",
      "refs": [
        "KDT8 ch5"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0007",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Common single base-pair change in DNA",
      "a": "Single-nucleotide polymorphism (SNP)",
      "refs": [
        "KDT8 ch5"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0008",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "class",
      "q": "Types of genetic variant: list all",
      "a": "Single-nucleotide variants; small insertions and deletions; copy number variants (whole-gene deletion or duplication); promoter variants; splice variants; exon variants that change protein; variants that act only as markers",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0009",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Meaning of *1 in star allele nomenclature",
      "a": "Functional allele (normal function)",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0010",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Star allele meaning",
      "a": "Gene name, asterisk and haplotype designation, e.g. CYP2C19*2",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0011",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "class",
