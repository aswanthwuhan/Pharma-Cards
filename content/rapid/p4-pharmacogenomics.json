        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0013",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Ultrarapid metaboliser",
      "a": "Greatly increased enzyme activity",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0014",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "class",
      "q": "Scenarios with large effects from one pharmacogene: list all",
      "a": "Key metabolic or transport step relies on one variable enzyme (e.g. CYP2D6 with codeine); target or off-target protein varies (e.g. aminoglycosides, MT-RNR1); biological setting changes effect (e.g. G6PD with antimalarials, rasburicase)",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0015",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Effect of low-function variant on a drug activated by one enzyme",
      "a": "Parent drug and upstream metabolites rise; downstream metabolites fall",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
      "id": "rf-p4-pharmacogenomics-0016",
      "subtopic": "p4-pharmacogenomics-foundations",
      "kind": "fact",
      "q": "Effect of gain-of-function variant on drug action",
      "a": "Low parent-drug concentration and loss of efficacy",
      "refs": [
        "GG14 ch7"
      ]
    },
    {
